# ============================================================================
# Matrix Authentication Service (MAS) Configuration
# ============================================================================
# MAS provides modern OIDC-based authentication for Matrix, enabling:
# - Phone number authentication
# - Social login (future)
# - Passkeys / WebAuthn (future)
# - Centralized session management
#
# Documentation: https://element-hq.github.io/matrix-authentication-service/
# ============================================================================

http:
  public_base: "https://${MAS_FQDN}/"
  listeners:
    - name: web
      resources:
        - name: discovery
        - name: human
        - name: oauth
        - name: compat
        - name: graphql
        - name: assets
      binds:
        - address: "0.0.0.0:8090"

# ============================================================================
# Database Configuration
# ============================================================================
database:
  uri: "postgresql://postgres:${SECRETS_POSTGRES_PASSWORD}@postgres/mas"
  max_connections: 10
# ============================================================================
# Secrets for Token Signing
# ============================================================================
# Encryption secret from .env, signing key from file (generated by init-env.sh)
secrets:
  encryption: "${SECRETS_MAS_ENCRYPTION_SECRET}"
  keys:
    - kid: "${MAS_KEY_ID}"
      key: |
${MAS_SIGNING_KEY_INDENTED}

# ============================================================================
# Matrix Homeserver Connection
# ============================================================================
# Documentation: https://element-hq.github.io/matrix-authentication-service/setup/homeserver.html
matrix:
  homeserver: "${DOMAIN}"
  endpoint: "http://synapse:8008"
  secret: "${SECRETS_MAS_ADMIN_TOKEN}"  # Must match Synapse MSC3861 admin_token

# ============================================================================
# Clients Configuration
# ============================================================================
# Pre-register Synapse as an OAuth client (required for MSC3861 delegation)
# Documentation: https://element-hq.github.io/matrix-authentication-service/setup/homeserver.html
clients:
  - client_id: "01HMX5W5W5W5W5W5W5W5W5W5W5"
    client_auth_method: "client_secret_basic"
    client_secret: "${SECRETS_MAS_MATRIX_SECRET}"

# ============================================================================
# Upstream OAuth 2.0 / OIDC Providers (SSO)
# ============================================================================
# Documentation: https://element-hq.github.io/matrix-authentication-service/setup/sso.html
upstream_oauth2:
  providers:
    # Discord SSO Provider
    - id: "01G9NKR3Y0FZXV695QK7C36N5N"
      issuer: "https://discord.com"
      human_name: "Discord"
      brand_name: "discord"

      token_endpoint_auth_method: "client_secret_post"
      client_id: "${DISCORD_CLIENT_ID}"
      client_secret: "${DISCORD_CLIENT_SECRET}"
      scope: "openid identify email"
      pkce_method: "auto"
      claims_imports:
        localpart:
          action: "suggest"
          template: "{{ user.username }}"
        displayname:
          action: "suggest"
          template: "{{ user.global_name }}"
      additional_authorization_parameters:
        prompt: "none"

    # Google SSO Provider
    - id: "01G9NKR3Y0FZXV695QK7C36N5M"
      issuer: "https://accounts.google.com"
      human_name: "Google"
      brand_name: "google"
      token_endpoint_auth_method: "client_secret_post"
      client_id: "${GOOGLE_CLIENT_ID}"
      client_secret: "${GOOGLE_CLIENT_SECRET}"
      scope: "openid profile email"
      pkce_method: "auto"
      claims_imports:
        localpart:
          action: "suggest"
          template: "{{ user.email | split(pattern='@') | first }}"
        displayname:
          action: "suggest"
          template: "{{ user.name }}"
        email:
          action: "require"
          template: "{{ user.email }}"
          set_email_verification: "import"

# ============================================================================
# Account Management & Policies
# ============================================================================
# User must agree to terms before using the service
policies:
  # Policy URI that users must accept
  # policy_uri: "https://rumpusroom.xyz/privacy"


# Account features configuration  
account:
  # Email verification is handled by upstream providers (Discord)
  email_verification: enabled
  password_recovery_enabled: true
  # Enable self-service password registration
  password_registration_enabled: true
  # Require a valid registration token to register an account
  registration_token_required: true

# ============================================================================
# Password Authentication
# ============================================================================
# Enable password-based authentication for initial user registration
passwords:
  enabled: true
  schemes:
    - version: 1
      algorithm: argon2id
  minimum_complexity: 4  # 0=very weak, 4=very strong

# ============================================================================
# Email Configuration (Optional - for password recovery)
# ============================================================================
email:
  from: '"The Rumpus Room" <${GMAIL_ACCOUNT}>'
  reply_to: '"The Rumpus Room" <${GMAIL_ACCOUNT}>'
  transport: smtp
  hostname: smtp.gmail.com
  port: 587
  mode: starttls
  username: "${GMAIL_ACCOUNT}"
  password: "${GMAIL_APP_PASSWORD}"

# ============================================================================
# Branding (Optional)
# ============================================================================
branding:
  service_name: "The Rumpus Room"
  # policy_uri: "https://rumpusroom.xyz/privacy"
  # tos_uri: "https://rumpusroom.xyz/terms"

# ============================================================================
# Telemetry (Optional)
# ============================================================================
telemetry:

  metrics:
    exporter: prometheus
    bind: "0.0.0.0:8081"

# ============================================================================
# Notes
# ============================================================================
# After deploying MAS:
# 1. Initialize the database: make mas-init
# 2. Create admin user: make mas-create-admin
# 3. Configure phone auth via the admin UI at: https://matrix.rumpusroom.xyz/_auth/
