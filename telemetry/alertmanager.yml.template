# Alertmanager Configuration
global:
  smtp_smarthost: 'smtp.gmail.com:587'
  smtp_from: '${GMAIL_ACCOUNT}'
  smtp_auth_username: '${GMAIL_ACCOUNT}'
  smtp_auth_password: '${GMAIL_APP_PASSWORD}'
  smtp_require_tls: true

route:
  group_by: ['alertname']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: 'email-alert'

receivers:
  - name: 'email-alert'
    email_configs:
      - to: '${GMAIL_ACCOUNT}'
        send_resolved: true
        html: '{{ template "email.default.html" . }}'
        headers:
          subject: '[Matrix] {{ if eq .Status "firing" }}CRITICAL DOWN{{ else }}RESOLVED{{ end }}: {{ .CommonAnnotations.summary }}'
