# Matrix Synapse Configuration
# Example Environment Variables (Copy to .env)

# Domain Configuration
DOMAIN=rumpusroom.xyz
MATRIX_FQDN=matrix.rumpusroom.xyz
ELEMENT_WEB_FQDN=element-web.rumpusroom.xyz
ELEMENT_CALL_FQDN=element-call.rumpusroom.xyz
LIVEKIT_FQDN=livekit.rumpusroom.xyz
CHAT_FQDN=chat.rumpusroom.xyz
CALL_FQDN=call.rumpusroom.xyz

# Auto-populated during local development
MATRIX_PORT=
ELEMENT_PORT=
MAS_PORT=
MAS_PUBLIC_BASE=https://matrix.rumpusroom.xyz/

# Synapse Configuration
SYNAPSE_SERVER_NAME=rumpusroom.xyz
SYNAPSE_REPORT_STATS=no

# PostgreSQL Database
SECRETS_POSTGRES_PASSWORD=your_secure_postgres_password_here

# TURN/STUN Server (for voice/video calls)
SECRETS_TURN_SHARED_SECRET=your_secure_turn_secret_here
TURN_REALM=rumpusroom.xyz

# Matrix Authentication Service (MAS)
MAS_DB_PASSWORD=your_secure_mas_db_password_here
MAS_ENCRYPTION_SECRET=your_secure_mas_encryption_secret_here
MAS_KEY_ID=your_key_id_here
MAS_SYNAPSE_SHARED_SECRET=your_secure_mas_synapse_secret_here
MAS_ADMIN_TOKEN=your_secure_mas_admin_token_here

# Discord SSO OAuth
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# Google SSO OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Gmail SMTP Authentication (for recovery emails)
GMAIL_ACCOUNT=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_gmail_app_password

# LiveKit (SFU for Element Call)
LIVEKIT_KEY=your_livekit_api_key_here
LIVEKIT_SECRET=your_livekit_api_secret_here
