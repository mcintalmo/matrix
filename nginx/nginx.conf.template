events {}

http {
    # Security: Hide Nginx Version
    server_tokens off;

    # Speed optimizations
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    # Docker internal DNS resolver (127.0.0.11)
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    # SSL session caching - returning visitors skip the full handshake
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Rate Limiting Zones (Anti-Brute Force & Anti-DoS)
    limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/m;
    limit_req_zone $binary_remote_addr zone=rageshake_limit:10m rate=10r/m;
    limit_req_zone $binary_remote_addr zone=api_burst:20m rate=30r/s;
    limit_req_status 429;

    # Redirect all HTTP traffic to HTTPS
    server {
        listen 80;
        server_name ${MATRIX_FQDN} ${DOMAIN} ${CHAT_FQDN} ${ELEMENT_WEB_FQDN} element.${DOMAIN} ${CALL_FQDN} ${ELEMENT_CALL_FQDN} ${LIVEKIT_FQDN} headscale.${DOMAIN};

        # ACME challenge for Let's Encrypt renewals
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # Main server block for Matrix and MAS API endpoints
    server {
        listen 443 ssl http2;
        server_name ${MATRIX_FQDN} ${DOMAIN};

        ssl_certificate /etc/letsencrypt/live/${MATRIX_FQDN}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${MATRIX_FQDN}/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;

        # Security Headers
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options SAMEORIGIN always;

        # OCSP stapling - server pre-fetches cert status so browsers don't have to
        ssl_stapling on;
        ssl_stapling_verify on;
        ssl_trusted_certificate /etc/letsencrypt/live/${MATRIX_FQDN}/chain.pem;

        # ACME challenge for Let's Encrypt renewals (Cloudflare HTTPS Redirect bypass)
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        # Well-Known Discovery (served inline by nginx)
        location /.well-known/matrix/server {
            default_type application/json;
            add_header Access-Control-Allow-Origin * always;
            add_header "Access-Control-Allow-Methods" "GET, POST, PUT, DELETE, OPTIONS" always;
            add_header "Access-Control-Allow-Headers" "Origin, X-Requested-With, Content-Type, Accept, Authorization" always;

            if ($request_method = OPTIONS) {
                add_header "Access-Control-Allow-Origin" * always;
                add_header "Access-Control-Allow-Methods" "GET, POST, PUT, DELETE, OPTIONS" always;
                add_header "Access-Control-Allow-Headers" "Origin, X-Requested-With, Content-Type, Accept, Authorization" always;
                add_header "Access-Control-Max-Age" 86400;
                add_header "Content-Type" "text/plain charset=UTF-8";
                add_header "Content-Length" 0;
                return 204;
            }

            return 200 '{"m.server": "${MATRIX_FQDN}:443"}';
        }

        location /.well-known/matrix/client {
            default_type application/json;
            add_header Access-Control-Allow-Origin * always;
            add_header "Access-Control-Allow-Methods" "GET, POST, PUT, DELETE, OPTIONS" always;
            add_header "Access-Control-Allow-Headers" "Origin, X-Requested-With, Content-Type, Accept, Authorization" always;

            if ($request_method = OPTIONS) {
                add_header "Access-Control-Allow-Origin" * always;
                add_header "Access-Control-Allow-Methods" "GET, POST, PUT, DELETE, OPTIONS" always;
                add_header "Access-Control-Allow-Headers" "Origin, X-Requested-With, Content-Type, Accept, Authorization" always;
                add_header "Access-Control-Max-Age" 86400;
                add_header "Content-Type" "text/plain charset=UTF-8";
                add_header "Content-Length" 0;
                return 204;
            }

            return 200 '{
                "m.homeserver": {
                    "base_url": "https://${MATRIX_FQDN}"
                },
                "org.matrix.msc2965.authentication": {
                    "issuer": "https://${MATRIX_FQDN}/",
                    "account": "https://${MATRIX_FQDN}/account"
                },
                "org.matrix.msc4143.rtc_foci": [
                    {
                        "type": "livekit",
                        "livekit_service_url": "https://${CALL_FQDN}/jwt"
                    }
                ],
                "io.element.e2ee": {
                    "secure_backup_required": true
                }
            }';
        }

        # ── Synapse Generic Worker Routes ─────────────────────────────────────────
        # Offload client sync and events to synapse-generic-worker-1
        location ~ ^/_matrix/client/(r0|v3)/sync$ {
            proxy_pass http://synapse-generic-worker-1:8081;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $host;
            proxy_set_header Authorization $http_authorization;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_read_timeout 600s;
        }

        location ~ ^/_matrix/client/(api/v1|r0|v3)/events$ {
            proxy_pass http://synapse-generic-worker-1:8081;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $host;
            proxy_set_header Authorization $http_authorization;
            proxy_read_timeout 600s;
        }

        location ~ ^/_matrix/client/(api/v1|r0|v3)/initialSync$ {
            proxy_pass http://synapse-generic-worker-1:8081;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $host;
            proxy_set_header Authorization $http_authorization;
            proxy_read_timeout 600s;
        }

        location ~ ^/_matrix/client/(api/v1|r0|v3)/rooms/[^/]+/initialSync$ {
            proxy_pass http://synapse-generic-worker-1:8081;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $host;
            proxy_set_header Authorization $http_authorization;
            proxy_read_timeout 600s;
        }

        # ── Matrix Authentication Service (MAS) Routes ────────────────────────────
        # Strict rate limiting on credential authentication endpoints (anti-brute-force)
        location ~ ^/_matrix/client/(.*)/(login|register) {
            limit_req zone=auth_limit burst=5 nodelay;
            proxy_pass http://mas:8090;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $host;
            proxy_set_header Authorization $http_authorization;
        }

        # Static assets for MAS web UI (unthrottled)
        location ~ ^/assets(/.*)?$ {
            proxy_pass http://mas:8090;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $host;
        }

        # Interactive UI APIs (GraphQL, OAuth, user management) with high burst headroom
        location ~ ^/(.well-known/openid-configuration|_auth|oauth2|upstream|graphql)(/.*)?$ {
            limit_req zone=api_burst burst=50 nodelay;
            proxy_pass http://mas:8090;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $host;
            proxy_set_header Authorization $http_authorization;
        }

        # ── Grafana Telemetry Dashboard (Protected root path) ───────────────────
        location /_grafana/ {
            proxy_pass http://grafana:3000;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_hide_header X-Frame-Options;
            add_header Cache-Control "no-cache";

            # Require basic authentication for an extra layer of security
            # (Requires setting up an htpasswd file via deploy.sh)
            auth_basic "Restricted Telemetry Access";
            auth_basic_user_file /etc/nginx/.htpasswd;
        }

        # ── Synapse Main App Routes ───────────────────────────────────────────
        
        # Element Web Rageshake / Crash Telemetry Interceptor
        location /_matrix/client/unstable/rageshake/submit {
            limit_req zone=rageshake_limit burst=3 nodelay;
            proxy_pass http://rageshake-webhook:8000/submit;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $host;
            client_max_body_size 50M;
        }

        location /_matrix/client/unstable/rageshake/health {
            proxy_pass http://rageshake-webhook:8000/health;
        }

        location /rageshake/ {
            proxy_pass http://rageshake-webhook:8000/;
        }

        # Synapse: Matrix client/federation API routes
        location /_matrix {
            limit_req zone=api_burst burst=50 nodelay;
            proxy_pass http://synapse:8008;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $host;
            proxy_set_header Authorization $http_authorization;
            client_max_body_size 50M;
        }

        location /_synapse/client {
            proxy_pass http://synapse:8008;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $host;
            proxy_set_header Authorization $http_authorization;
            client_max_body_size 50M;
        }

        # Health check
        location /health {
            proxy_pass http://synapse:8008/health;
        }

        # Everything else goes to MAS (login, register, consent, oauth2, account, etc.)
        location / {
            proxy_pass http://mas:8090;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $host;
            proxy_set_header Authorization $http_authorization;
        }
    }

    # Canonical Redirect Block: Routing legacy Element aliases to the primary Web frontend
    server {
        listen 443 ssl http2;
        server_name ${CHAT_FQDN} element.${DOMAIN};

        ssl_certificate /etc/letsencrypt/live/${MATRIX_FQDN}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${MATRIX_FQDN}/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;

        # ACME challenge for Let's Encrypt renewals (Cloudflare HTTPS Redirect bypass)
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://${ELEMENT_WEB_FQDN}$request_uri;
        }
    }

    # Element Web Application Block
    server {
        listen 443 ssl http2;
        server_name ${ELEMENT_WEB_FQDN};

        ssl_certificate /etc/letsencrypt/live/${MATRIX_FQDN}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${MATRIX_FQDN}/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;

        # Security Headers
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options SAMEORIGIN always;

        ssl_stapling on;
        ssl_stapling_verify on;
        ssl_trusted_certificate /etc/letsencrypt/live/${MATRIX_FQDN}/chain.pem;

        # ACME challenge for Let's Encrypt renewals (Cloudflare HTTPS Redirect bypass)
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location ~* \.(js|css|woff2|woff|ttf|ico|png|svg|jpg|webp)$ {
            proxy_pass http://element-web:80;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $host;
            add_header Cache-Control "public, max-age=31536000, immutable";
        }

        location / {
            proxy_pass http://element-web:80;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $host;
            add_header Cache-Control "no-cache";
        }
    }

    # Element Call Application Block
    server {
        listen 443 ssl http2;
        server_name ${CALL_FQDN} ${ELEMENT_CALL_FQDN};

        ssl_certificate /etc/letsencrypt/live/${MATRIX_FQDN}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${MATRIX_FQDN}/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;

        # Security Headers
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options SAMEORIGIN always;

        # ACME challenge for Let's Encrypt renewals (Cloudflare HTTPS Redirect bypass)
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        # Route WebRTC JWT token generation to the helper microservice
        location /jwt/ {
            rewrite ^/jwt/(.*) /$1 break;
            proxy_pass http://livekit-jwt:8080;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $host;
            # WebSockets support
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }

        # Route WebRTC signaling to the LiveKit server
        location /rtc {
            # Legacy stub mapping to gently migrate client cache over
            return 301 https://${LIVEKIT_FQDN}/rtc;
        }

        location / {
            proxy_pass http://element-call:8080;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $host;
            add_header Cache-Control "no-cache";
        }
    }

    # LiveKit Media Server Block
    server {
        listen 443 ssl http2;
        server_name ${LIVEKIT_FQDN};

        ssl_certificate /etc/letsencrypt/live/${MATRIX_FQDN}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${MATRIX_FQDN}/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;

        # Security Headers
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options SAMEORIGIN always;

        # ACME challenge for Let's Encrypt renewals (Cloudflare HTTPS Redirect bypass)
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            proxy_pass http://livekit:7880;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $host;
            # WebSockets support
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }
    }

    # Headscale VPN Coordination Server Block
    server {
        listen 443 ssl http2;
        server_name headscale.${DOMAIN};

        ssl_certificate /etc/letsencrypt/live/${MATRIX_FQDN}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${MATRIX_FQDN}/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;

        # Security Headers
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options SAMEORIGIN always;

        # ACME challenge for Let's Encrypt renewals
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            proxy_pass http://headscale:8080;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_read_timeout 86400;
        }
    }
}