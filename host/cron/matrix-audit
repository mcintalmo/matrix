#!/bin/sh
# Daily automated Lynis security compliance audit
if [ -x /opt/matrix/app/scripts/matrix-ctl ]; then
    /opt/matrix/app/scripts/matrix-ctl audit > /var/log/lynis-cron.log 2>&1
elif command -v lynis >/dev/null 2>&1; then
    lynis audit system --quick --warnings-only > /var/log/lynis-cron.log 2>&1
fi
