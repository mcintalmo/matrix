{
    "default_server_config": {
        "m.homeserver": {
            "base_url": "https://${MATRIX_FQDN}",
            "server_name": "${DOMAIN}"
        }
    },
    "disable_custom_urls": true,
    "disable_guests": true,
    "disable_login_language_selector": false,
    "disable_3pid_login": false,
    "force_verification": false,
    "brand": "The Rumpus Room",
    "default_widget_container_height": 280,
    "default_country_code": "US",
    "show_labs_settings": false,
    "features": {
        "feature_video_rooms": true,
        "feature_group_calls": true,
        "feature_element_call_video_rooms": false,
        "feature_matrix_rtc": true,
        "feature_oidc_native_flow": true,
        "feature_require_secure_backup_setup": true
    },
    "default_federate": true,
    "default_theme": "system",
    "room_directory": {
        "servers": ["${DOMAIN}"]
    },
    "setting_defaults": {
        "breadcrumbs": true,
        "videoInputMuted": true,
        "audioInputMuted": false,
        "Voice.use_webrtc_for_video_rooms": true,
        "im.vector.web.voice_video_settings": {
            "audioInput": true,
            "videoInput": false
        },
        "io.element.video_rooms": {
            "defaultAudioEnabled": true,
            "defaultVideoEnabled": false,
            "skipLobby": true
        }
    },
    "element_call": {
        "url": "https://${CALL_FQDN}?skipLobby=true&intent=audio",
        "guest_spa_url": "https://${CALL_FQDN}?skipLobby=true&intent=audio"
    },
    "livekit": {
        "livekit_service_url": "https://${CALL_FQDN}/jwt"
    },
    "bug_report_endpoint_url": "https://${MATRIX_FQDN}/_matrix/client/unstable/rageshake/submit",
    "rageshake_submit_url": "https://${MATRIX_FQDN}/_matrix/client/unstable/rageshake/submit"
}
